root = true

[*.cs]
# Unused using directives. Enforced at build so they cannot accumulate; the generated API client
# is excluded automatically by its <auto-generated> header.
dotnet_diagnostic.IDE0005.severity = warning

# CA1716: Identifiers should not match keywords. Guards cross-language consumers (e.g. VB's Get);
# the libraries' consumers are C#, and renaming Features.Get or IDdCorrespondenceService.Get would
# break the published API.
dotnet_diagnostic.CA1716.severity = none

[Altinn.Dd.InternalEvents/Estate/DeclarationSubmittedEvent.cs]
# CA1051: Do not declare visible instance fields. DaCaseId is a field in the published API and nothing
# deserialises with this class; it goes when oed-declaration is decommissioned, so it is not reworked.
dotnet_diagnostic.CA1051.severity = none

[Altinn.Dd.Correspondence/Models/CorrespondenceResult.cs]
# CA1000: Do not declare static members on generic types. Success and Failure are the published
# result type's factories; moving them would break consumers, and Failure could not infer T anyway.
dotnet_diagnostic.CA1000.severity = none
