<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Altinn.Dd.InternalEvents</PackageId>
    <!-- Version a local pack produces. The release workflow overrides it from the
         internalevents-v* tag, so this only needs to track what is being prepared.
         2.5.1 because the only change is XML documentation - no API change. -->
    <Version>2.5.1</Version>
    <Authors>Digitaliseringsdirektoratet</Authors>
    <Company>Digitaliseringsdirektoratet</Company>
    <PackageTags>digdir;altinn;oed;digitalt dødsbo;events</PackageTags>
    <Description>
      Shared contract for the internal events published in Digitalt dødsbo: event type names,
      resource ids, and the event payload models
    </Description>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/altinn/oed-messaging</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/altinn/oed-messaging</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
