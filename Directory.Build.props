<Project>

  <PropertyGroup>
    <!-- Commit packages.lock.json for reproducible restores, locked-mode
         restores in CI, and a complete transitive graph for the audit below.

         It does NOT reach GitHub's dependency graph, which does not parse this
         format at all - that needs Automatic dependency submission, under
         Settings > Advanced Security > Dependency graph. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>

    <!-- Surface transitive advisories at restore time. Every severity is
         reported as a warning; high and critical also fail the restore.

         NuGet encodes severity in the code - NU1901 low, NU1902 moderate,
         NU1903 high, NU1904 critical - so promoting only the top two keeps a
         newly published moderate visible without breaking the build. Do not
         add NuGetAuditLevel: that filters findings out of the output instead
         of changing whether they fail. -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <WarningsAsErrors>NU1903;NU1904</WarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Generate the XML documentation file. The published libraries ship it so consumers get
         IntelliSense, and CS1591 keeps their public surface documented. It is also a prerequisite
         for IDE0005 below: that analyser is silent at build time without it, which is why the
         non-shipping projects generate the file too and just mute CS1591.

         EnforceCodeStyleInBuild runs the IDE analysers as part of the build. Only the rules
         explicitly raised in .editorconfig are reported; everything else stays at its default
         severity and does not affect the build. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

</Project>
